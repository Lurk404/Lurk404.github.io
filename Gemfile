# Only used to preview the site on your own computer (bundle exec jekyll serve).
# GitHub Pages builds the site with its own settings and ignores this file.
source "https://rubygems.org"

# Everything GitHub Pages uses, at the same versions (includes all the plugins
# listed in _config.yml)
gem "github-pages", group: :jekyll_plugins
gem "webrick"   # needed by "jekyll serve" on Ruby 3+

# Windows only
gem "tzinfo-data", platforms: [:windows, :jruby]
gem "wdm", "~> 0.1", platforms: [:windows]
